{
  "name": "form-filler",
  "version": "2.5.0",
  "private": true,
  "license": "MIT",
  "description": "Fill hard forms easily: blanks found from the page or the PDF's own fields, loose answers placed in order, your details and today's date filled, templates, mail merge, handwriting read on the device.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/lib/index.js",
    "./files/node": "./src/lib/files/node.js"
  },
  "bin": {
    "form-filler": "bin/form-filler.mjs"
  },
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare-assets && vite --host 127.0.0.1",
    "build": "npm run prepare-assets && vite build",
    "test": "node --test tests/*.test.js",
    "walk": "node scripts/walk.cjs dist",
    "walk:webkit": "node scripts/walk.cjs dist --engine webkit",
    "check:handwriting": "node scripts/check-handwriting.mjs",
    "never-list": "node scripts/never-list.mjs",
    "hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@fontsource/caveat": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0",
    "@huggingface/transformers": "4.3.2",
    "@tesseract.js-data/eng": "1.0.0",
    "pdfjs-dist": "6.5.438",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "tesseract.js": "7.0.0",
    "vite": "7.3.7"
  }
}
